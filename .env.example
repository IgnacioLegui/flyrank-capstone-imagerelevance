# Copy to .env and fill in. .env is gitignored; never commit real values.

# Gemini API key from Google AI Studio (free tier, no card).
GEMINI_API_KEY=your-gemini-api-key-here

# Vision model. Google limits gemini-2.5-* to projects that already used them, so new keys
# should use a current model. Must have a price in app/ai/pricing.py.
VISION_MODEL=gemini-3.5-flash-lite

# Max Gemini requests per minute the worker sends. Set it at or below your project's free-tier
# RPM shown in Google AI Studio (rate limits are per project and not published in the docs).
GEMINI_RPM=5

# Seconds before a single Gemini request is abandoned (counts as a failed attempt for that image).
GEMINI_TIMEOUT_S=60

# Postgres (docker compose). Inside containers the host is "db" instead of "localhost".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imagerelevance

# Folder with the image corpus (docker compose overrides this with the read-only mount).
IMAGES_DIR=data/images

# --- Mismatch guard thresholds (PROVISIONAL — calibrated on real scores in Phase 3) ---
# Vision confidence below this => image is flagged, never used as a match.
MIN_CONFIDENCE=0.70
# Post subject-extraction confidence below this => guard rule G5 refuses to match the post at all.
MIN_POST_CONFIDENCE=0.50
# Cosine similarity (post vs image) below this => candidate rejected.
MIN_SIMILARITY=0.65
# How many top-ranked candidates the guard evaluates per post.
GUARD_TOP_K=5

# --- Cost tracking ---
# Total list-price-equivalent spend (USD) after which the worker refuses new AI calls.
AI_BUDGET_USD=1.00
