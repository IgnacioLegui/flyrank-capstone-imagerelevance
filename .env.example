# Copy to .env and fill in. .env is gitignored; never commit real values.

# Gemini API key from Google AI Studio (free tier, no card).
GEMINI_API_KEY=your-gemini-api-key-here

# Postgres (docker compose). Inside containers the host is "db" instead of "localhost".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/imagerelevance

# --- Mismatch guard thresholds (PROVISIONAL — calibrated on real scores in Phase 3) ---
# Vision confidence below this => image is flagged, never used as a match.
MIN_CONFIDENCE=0.70
# Post subject-extraction confidence below this => guard rule G5 refuses to match the post at all.
MIN_POST_CONFIDENCE=0.50
# Cosine similarity (post vs image) below this => candidate rejected.
MIN_SIMILARITY=0.65
# How many top-ranked candidates the guard evaluates per post.
GUARD_TOP_K=5

# --- Cost tracking ---
# Total list-price-equivalent spend (USD) after which the worker refuses new AI calls.
AI_BUDGET_USD=1.00
